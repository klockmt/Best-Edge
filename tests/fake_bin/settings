#!/bin/sh
# Mock de settings: valores em $FAKE_STATE/settings_<ns> no formato chave=valor.
ns_file() { echo "$FAKE_STATE/settings_$1"; }
case "$1" in
  list) cat "$(ns_file "$2")" 2>/dev/null ;;
  get) v=$(grep "^$3=" "$(ns_file "$2")" 2>/dev/null | cut -d= -f2-); echo "${v:-null}" ;;
  put) sed -i "/^$3=/d" "$(ns_file "$2")" 2>/dev/null; echo "$3=$4" >> "$(ns_file "$2")" ;;
  delete) sed -i "/^$3=/d" "$(ns_file "$2")" 2>/dev/null ;;
esac
